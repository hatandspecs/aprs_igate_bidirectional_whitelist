# Copy to `pi.secrets` and fill in. pi.secrets is gitignored — it holds the
# login password for the Pi and the pre-shared keys for every WiFi network the
# Pi should join. Never commit it.
#
# Same "key = value" format as igate.conf.

# Login password for PI_USER. Also usable over SSH unless key-only auth is set.
PI_USER_PASSWORD = change-me

# WiFi networks, numbered from 1. The Pi tries them in order — 1 is preferred.
# Add as many as needed; the builder reads until a number is missing.
WIFI_1_SSID = HomeNetwork
WIFI_1_PSK = home-wifi-password

# WIFI_2_SSID = Phone Hotspot
# WIFI_2_PSK = hotspot-password

# Hidden networks need this so the Pi probes for them rather than waiting to
# hear a beacon. Omit or set to no for normal networks.
# WIFI_2_HIDDEN = yes
