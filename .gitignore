# Real APRS-IS passcode — see README.md. Never commit this.
igate.secrets
aprsfi.secrets

# Generated at runtime: rendered direwolf.conf, container logs, etc.
run/
__pycache__/

# Pi login password and WiFi pre-shared keys. Never commit this.
pi.secrets

# Downloaded and generated Raspberry Pi images.
pi-build/

# Per-machine configuration: DEPLOY_MODE, RADIO, WEB_* and hardware overrides for
# one machine only. See igate.local.conf.example. Never commit this.
igate.local.conf


# scratch notes
scratch_notes.txt

# Frame-log archives pulled off the Pi. `run/` is tmpfs, so these are the only
# copy of a measurement window once the station reboots -- but they are large
# and every position report in them is a real station's coordinates, including
# this one's. Keep them, do not publish them.
archive-*/
