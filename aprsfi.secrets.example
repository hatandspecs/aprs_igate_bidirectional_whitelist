# aprs.fi API key for KD3CCO. Gitignored — do not commit.
#
# This is a workstation query credential, not a station secret. The iGate
# daemon never calls aprs.fi: this file is read by hand (and by assistants)
# for path and message lookups against APRS-IS from off the Pi.
#
# Deliberately NOT in igate.secrets. That file holds IGLOGIN_PASSCODE and
# nothing else by construction (see apply_secrets in deploy_igate.sh): any
# other key there is ignored, reported as a LAYER_WARNING on every `config`
# run, and copied to the Pi by build_pi_image.sh for no reason.
#
# Usage:
#   . ./aprsfi.secrets
#   curl -s "https://api.aprs.fi/api/get?name=KD3CCO-7&what=loc&apikey=${APRSFI_API_KEY}&format=json"

APRSFI_API_KEY=your-key-here
