# Copy this file to `igate.secrets` (same directory) and fill in your real
# APRS-IS passcode. igate.secrets is listed in .gitignore — it will never be
# committed as long as you don't rename it or force-add it.
#
# Same "key = value" format as igate.conf. Only IGLOGIN_PASSCODE is read
# from here; any other key is ignored.

IGLOGIN_PASSCODE = 123456
